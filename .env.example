# ============================================================
# .env.example — PLANTILLA de configuración (sí se sube a GitHub)
# iniciar.py lo copia como ".env" automáticamente la primera vez.
# El archivo .env real NUNCA se sube (está en .gitignore).
#
# Los umbrales de abajo son solo VALORES POR DEFECTO: un administrador
# los puede cambiar en la aplicación (Configuración) sin reiniciar.
# ============================================================

# Ruta del archivo de base de datos SQLite
NOC_DB_PATH=data/noc.db

# Receptor Syslog UDP. 1 = encendido, 0 = apagado
SYSLOG_UDP_ENABLED=1
# 127.0.0.1 = solo acepta mensajes de este computador (laboratorio seguro)
SYSLOG_UDP_HOST=127.0.0.1
# Puerto UDP (5514 no requiere permisos de administrador; el estándar es 514)
SYSLOG_UDP_PORT=5514

# Severidad máxima que genera alerta (0=emergencia ... 7=debug). 3 = errores o más graves
ALERT_MIN_SEVERITY=3

# Ventana (segundos) para agrupar mensajes repetidos (control de tormentas)
DEDUP_WINDOW_SECONDS=60

# Máximo de mensajes aceptados por minuto POR EQUIPO (rate limit)
RATE_LIMIT_PER_MINUTE=300

# Severidad máxima que genera PROPUESTA de incidente (0-2 = emergency, alert, critical)
INCIDENT_MAX_SEVERITY=2

# Minutos sin eventos para considerar un equipo "sin comunicación"
NO_COMM_MINUTES=10

# OPCIONAL. El primer administrador se crea en la aplicación (configuración inicial).
# Solo si quiere los usuarios de laboratorio de "python -m app.seed", escriba aquí
# su contraseña inicial (mínimo 8 caracteres). Después cada usuario puede cambiarla.
NOC_CLAVE_INICIAL=

# 1 solo si la aplicación se publica con HTTPS (la cookie de sesión viaja cifrada)
NOC_COOKIE_SEGURA=0
